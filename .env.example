# ============ OKSleep 环境变量示例 ============
# 复制为 .env 后按需修改（.env 已被 gitignore，不会入库）

# 运行模式：demo（默认，无需任何 Key）/ live（真实 LLM）
OKSLEEP_LLM_MODE=demo

# OpenAI 兼容接口配置（demo 模式下可留空，自动使用 Mock）
# 示例：DeepSeek
# OKSLEEP_OPENAI_BASE_URL=https://api.deepseek.com/v1
# OKSLEEP_OPENAI_API_KEY=sk-xxxx
# OKSLEEP_LLM_MODEL=deepseek-chat
OKSLEEP_OPENAI_BASE_URL=
OKSLEEP_OPENAI_API_KEY=
OKSLEEP_LLM_MODEL=gpt-4o-mini

# SQLite 数据库文件路径（默认：仓库根目录 data/oksleep.db）
# OKSLEEP_DB_PATH=

# 后端服务端口（默认 8000）
# OKSLEEP_BACKEND_PORT=8000
